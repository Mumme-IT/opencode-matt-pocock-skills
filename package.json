{
  "name": "opencode-matt-pocock-skills",
  "version": "0.1.1",
  "description": "OpenCode plugin that installs and maintains Matt Pocock's skills collection",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mumme-IT/opencode-matt-pocock-skills.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.18"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "@types/node": "^22.18.0",
    "@types/proper-lockfile": "^4.1.4",
    "prettier": "^3.9.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
